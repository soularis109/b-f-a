generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "sqlite"
}

enum BillStatus {
  unpaid
}

model Bill {
  id        String     @id
  amount    Decimal
  payee     String
  status    BillStatus @default(unpaid)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("bills")
}
